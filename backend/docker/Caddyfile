{
	auto_https off
	admin off
}

# Railway terminates HTTPS before forwarding traffic to this container. The
# injected PORT is authoritative; 8000 is only a safe local image fallback.
:{$PORT:8000} {
	root * /var/www/html/public
	# Railway terminates TLS; keep this policy host-only so future nested API
	# domains are not forced onto HTTPS before their certificates are reviewed.
	header Strict-Transport-Security "max-age=63072000"
	encode zstd gzip
	php_fastcgi 127.0.0.1:9000
	file_server

	log {
		output stdout
		format json
	}
}
