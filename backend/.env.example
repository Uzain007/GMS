APP_NAME="IronCore API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Production must set the reviewed proxy/load-balancer CIDRs (or a provider-
# required `*` only when the API cannot receive direct public traffic).
TRUSTED_PROXIES=
APP_LOCALE=en

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ironcore
# Keep the API on the non-superuser role so PostgreSQL RLS remains effective.
DB_USERNAME=ironcore_app
DB_PASSWORD=change-me-app
# Local development may use `prefer`; production preflight requires an
# encrypted mode such as `require` or `verify-full`.
DB_SSLMODE=prefer

REDIS_CLIENT=phpredis
# Production preflight additionally requires a deployment-managed `REDIS_URL`
# using rediss:// with authentication. Host/port remain convenient locally.
REDIS_HOST=redis
REDIS_PORT=6379

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

SANCTUM_STATEFUL_DOMAINS=localhost:3000
# Leave blank on localhost; use a shared parent domain such as .ironcore.app in production.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax

MAIL_MAILER=log
MAIL_URL=
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@ironcore.test
MAIL_FROM_NAME="IronCore"

# Production containers should use `stderr` or another provider-collected sink.
LOG_CHANNEL=stack
LOG_STACK=single

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_ENDPOINT=

# Stripe Connect uses direct charges so each gym receives member payments.
# Never commit live values or expose these secret keys to the Next.js client.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_URL=https://api.stripe.com
STRIPE_CONNECT_REFRESH_URL=https://app.ironcore.example/payments?stripe=refresh
STRIPE_CONNECT_RETURN_URL=https://app.ironcore.example/payments?stripe=return
STRIPE_CHECKOUT_SUCCESS_URL=https://app.ironcore.example/payments?payment={PAYMENT_ID}&checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://app.ironcore.example/payments?payment={PAYMENT_ID}&checkout=cancelled

# The platform Billing endpoint is separate from Connect member-payment events.
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_BILLING_CHECKOUT_SUCCESS_URL=https://app.ironcore.example/billing?gym={GYM_ID}&checkout=success
STRIPE_BILLING_CHECKOUT_CANCEL_URL=https://app.ironcore.example/billing?gym={GYM_ID}&checkout=cancelled
STRIPE_BILLING_PORTAL_RETURN_URL=https://app.ironcore.example/billing

# Optional queued notification adapters. Keep tokens outside source control.
NOTIFICATION_SMS_ENDPOINT=
NOTIFICATION_SMS_TOKEN=
NOTIFICATION_PUSH_ENDPOINT=
NOTIFICATION_PUSH_TOKEN=
