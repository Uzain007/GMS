APP_URL=http://localhost:3000
API_URL=http://localhost:8000
# Public browser origin only; never place API secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_IRONCORE_API_URL=http://localhost:8000
NEXT_PUBLIC_IRONCORE_DEMO_MODE=false
# Production web preflight also requires NODE_ENV=production and the full
# VERCEL_GIT_COMMIT_SHA, GITHUB_SHA or an explicit IRONCORE_RELEASE_SHA from
# the deployment platform.
DATABASE_URL=postgresql://ironcore:change-me@localhost:5432/ironcore
REDIS_URL=redis://localhost:6379
STORAGE_ENDPOINT=
STORAGE_BUCKET=ironcore-files
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
